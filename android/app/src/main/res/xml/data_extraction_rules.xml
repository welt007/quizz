<?xml version="1.0" encoding="utf-8"?>
<!-- Android-Backup und Geräteumzug (ab Android 12), siehe backup_rules.xml -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="quizshow.xml" />
        <include domain="file" path="catalogs/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="quizshow.xml" />
        <include domain="file" path="catalogs/" />
    </device-transfer>
</data-extraction-rules>
